{
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "prConcurrentLimit": 3,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/test.yml"
      ],
      "matchStrings": [
        "(?m)^  DATATUG_VERSION: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)$"
      ],
      "depNameTemplate": "datatug/datatug-cli",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "datatug/datatug-cli"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ]
}
